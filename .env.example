# Copy to .env (git-ignored) and paste your key. Used only by the backend; never sent to the browser.
# Get a free key: https://build.nvidia.com/nvidia/nemotron-3.5-lightning-30b-a3b -> "Generate API Key"
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NEMOTRON_THINKING=false
