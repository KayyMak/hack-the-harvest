* text=auto eol=lf

# Preserve source bytes: baseline/original_sha256.json checks these files.
/README.md -text
/data_sources.md -text
/field_aoi.geojson -text
*.ipynb -text
*.gpkg binary

# Immutable result/reference snapshots are fingerprinted byte-for-byte.
/baseline/outputs/** -text whitespace=cr-at-eol
/data/reference/** -text whitespace=cr-at-eol
# Matplotlib SVG path data contains generated trailing whitespace.
/baseline/outputs/**/*.svg -whitespace

# 2025 forecast inputs: public NASS report text pinned by sha256 in forecast/sources.json.
/forecast/cache/** -text whitespace=cr-at-eol
/forecast/outputs/** -text whitespace=cr-at-eol
